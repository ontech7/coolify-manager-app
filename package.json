{
  "name": "coolify-manager-app",
  "main": "expo-router/entry",
  "version": "1.3.0",
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "ios": "cross-env APP_VARIANT=development expo run:ios",
    "ios-build": "eas build -p ios",
    "ios-build:submit": "eas build -p ios --auto-submit",
    "android": "cross-env APP_VARIANT=development expo run:android",
    "android-build:dev": "eas build -p android --profile development",
    "android-build:preview": "eas build -p android --profile preview",
    "android-build:prod": "eas build -p android --profile production",
    "web": "expo start --web",
    "lint": "expo lint",
    "clean": "rm -rf android ios dist"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@shopify/flash-list": "2.0.2",
    "date-fns": "^4.1.0",
    "expo": "~57.0.24",
    "expo-build-properties": "~57.0.21",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "babel-plugin-module-resolver": "^5.0.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "private": true
}
